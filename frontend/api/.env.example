# Adaptive-Agentic-GraphRAG Environment Configuration
# Copy this file to .env and populate with production secrets

# --- Application Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# --- LLM & Embedding Settings ---
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# --- Storage Layer Settings ---
# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag_password
NEO4J_DATABASE=neo4j

# ChromaDB Vector Database
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=adaptive_graphrag_chunks

# --- Algorithmic & Routing Thresholds ---
ROUTING_TAU_1=0.35
ROUTING_TAU_2=0.70
TEMPORAL_DECAY_LAMBDA=0.015
TEMPORAL_TAU_DECAY=0.30
VERIFICATION_THRESHOLD=0.75
MAX_RETRY_COUNT=3

# --- Verification Metric Weights ---
WEIGHT_FAITHFULNESS=0.50
WEIGHT_ANSWER_RELEVANCE=0.30
WEIGHT_TEMPORAL_VALIDITY=0.20
